# Vercel: Project -> Settings -> Environment Variables ga shularni kiriting.
# Mahalliy (o'z kompyuteringizda): shu faylni .env nomi bilan nusxalab, qiymatlarni yozing va `npm run local` ni ishga tushiring.
BOT_TOKEN=123456:ABC...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
APP_SECRET=kamida-32-belgili-tasodifiy-satr
ADMIN_KEY=admin-panel-paroli
WEBAPP_URL=https://sizning-loyiha.vercel.app
# (mahalliy ishga tushirishda WEBAPP_URL o'zi tunnel manzili bilan almashtiriladi — bu qatorga tegmasangiz ham bo'ladi)

# Ixtiyoriy (standart qiymatlar lib/config.js da)
CAMPUS_LAT=41.35202
CAMPUS_LON=69.22210
CAMPUS_RADIUS_M=300
MAX_GPS_ACCURACY_M=150
FACE_THRESHOLD=0.5
DEFAULT_GROUP=CYB3-26

# v2
OWNER_ID=7317966615

# --- Faqat mahalliy ishga tushirish uchun (npm run local), hammasi ixtiyoriy ---
# PORT=3000
# LOCAL_URL=https://sizning-doimiy-manzil.example   # o'zingiz ochgan doimiy tunnel bo'lsa; bo'lmasa Cloudflare tunnel avtomatik ochiladi
# NO_TUNNEL=1                                       # tunnelsiz (faqat http://localhost:3000 da ko'rish)
